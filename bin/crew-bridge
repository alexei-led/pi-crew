#!/bin/sh
# Run the pi-crew bridge with the tsx loader installed beside Pi's own pi-intercom.
set -eu
pkg=${PI_CREW_INTERCOM_PKG:-$HOME/.pi/agent/npm/node_modules/pi-intercom}
here=$(cd "$(dirname "$0")/.." && pwd)
exec node --import "$pkg/../tsx/dist/esm/index.mjs" "$here/bridge/crew-bridge.mts" "$@"
